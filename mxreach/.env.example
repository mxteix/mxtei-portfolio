# mxReach — copy to .env.local (dev) or set in Vercel (prod).

# mxReach's OWN Supabase project (not the mxtei.com one).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Where the app is served. Used in magic links, the Gmail OAuth redirect and
# unsubscribe links, so it must be the real public URL in production.
APP_URL=http://localhost:3100

# openssl rand -base64 32   (encrypts Gmail refresh tokens at rest; never change
# it once mailboxes are connected, or they'll all need reconnecting)
TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 48   (signs unsubscribe links and the OAuth state cookie)
APP_SECRET=
# openssl rand -base64 32   (the cron caller sends "Authorization: Bearer <this>")
CRON_SECRET=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Redirect URI: <APP_URL>/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# hunter.io → API. Free tier is enough while building. Without it, lookups
# only read published pages and nothing can be verified (so nothing sends).
HUNTER_API_KEY=
